#!/usr/bin/env python3
"""Convert an SRT sidecar to a reversible One Pace-styled ASS sidecar."""

from __future__ import annotations

import argparse
import difflib
import re
import subprocess
import tempfile
from pathlib import Path


STYLE_SECTION = """[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Default,Impress BT Pace,82,&H00FFFFFF,&H000000FF,&H00000000,&H78000000,0,0,0,0,100,100,0,0,1,3.8,3.8,2,300,300,27,1

"""

SRT_BLOCK_RE = re.compile(
    r"(?ms)^\s*\d+\s*\n"
    r"\d\d:\d\d:\d\d[,.]\d{3}\s+-->[^\n]*\n"
    r"(.*?)"
    r"(?=\n\s*\n\s*\d+\s*\n"
    r"\d\d:\d\d:\d\d[,.]\d{3}\s+-->|\Z)"
)


def visible_text(text: str) -> str:
    """Normalize subtitle text for semantic cue-loss validation."""
    text = text.replace(r"\N", "\n")
    text = re.sub(r"<[^>]+>", "", text)
    text = re.sub(r"\{\\[^}]+\}", "", text)
    return " ".join(text.split())


def validate_omitted_cues(source_text: str, ass_text: str) -> int:
    """Allow FFmpeg to omit only empty or immediately duplicated SRT cues."""
    source_lines = [visible_text(text) for text in SRT_BLOCK_RE.findall(source_text)]
    ass_lines = [
        visible_text(line.split(",", 9)[9])
        for line in ass_text.splitlines()
        if line.startswith("Dialogue:")
    ]
    matcher = difflib.SequenceMatcher(a=source_lines, b=ass_lines, autojunk=False)
    omitted = 0
    for tag, source_start, source_end, ass_start, ass_end in matcher.get_opcodes():
        if tag == "equal":
            continue
        if tag != "delete":
            raise SystemExit(
                "Converted ASS changed subtitle text unexpectedly: "
                f"operation={tag}, SRT={source_start}:{source_end}, "
                f"ASS={ass_start}:{ass_end}"
            )
        for index in range(source_start, source_end):
            text = source_lines[index]
            previous = source_lines[index - 1] if index > 0 else None
            following = (
                source_lines[index + 1] if index + 1 < len(source_lines) else None
            )
            if text and text != previous and text != following:
                raise SystemExit(
                    "Converted ASS omitted a non-duplicate visible cue: "
                    f"SRT cue {index + 1}: {text!r}"
                )
            omitted += 1
    return omitted


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Convert SRT to ASS using the One Pace Main subtitle style."
    )
    parser.add_argument("input", type=Path, help="UTF-8 SRT input")
    parser.add_argument("output", type=Path, help="ASS output")
    parser.add_argument(
        "--force", action="store_true", help="replace an existing output file"
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    source = args.input.resolve()
    output = args.output.resolve()

    if source.suffix.lower() != ".srt":
        raise SystemExit(f"Input must be .srt: {source}")
    if output.suffix.lower() != ".ass":
        raise SystemExit(f"Output must be .ass: {output}")
    if not source.is_file():
        raise SystemExit(f"Input not found: {source}")
    if output.exists() and not args.force:
        raise SystemExit(f"Output already exists (use --force): {output}")

    source_bytes = source.read_bytes()
    try:
        source_text = source_bytes.decode("utf-8-sig")
        ffmpeg_input_options: list[str] = []
    except UnicodeDecodeError:
        # A few older subtitle downloads use Windows/Latin-1 encoding.
        # Preserve their characters instead of rejecting or mangling them.
        source_text = source_bytes.decode("iso-8859-1")
        ffmpeg_input_options = ["-sub_charenc", "ISO-8859-1"]

    source_cues = len(re.findall(r"(?m)^\s*\d\d:\d\d:\d\d[,.]\d{3}\s+-->", source_text))
    if source_cues == 0:
        raise SystemExit(f"No SRT cues found: {source}")

    output.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="onepace-ass-") as temp_dir:
        temporary_ass = Path(temp_dir) / "converted.ass"
        subprocess.run(
            [
                "ffmpeg",
                "-v",
                "error",
                "-nostdin",
                *ffmpeg_input_options,
                "-i",
                str(source),
                "-map",
                "0:s:0",
                "-c:s",
                "ass",
                str(temporary_ass),
            ],
            check=True,
        )
        ass_text = temporary_ass.read_text(encoding="utf-8-sig")

    ass_text = re.sub(r"(?m)^PlayResX:.*$", "PlayResX: 1920", ass_text)
    ass_text = re.sub(r"(?m)^PlayResY:.*$", "PlayResY: 1080", ass_text)
    if "LayoutResX:" not in ass_text:
        ass_text = ass_text.replace(
            "PlayResX: 1920\n",
            "PlayResX: 1920\nLayoutResX: 1920\nLayoutResY: 1080\n",
            1,
        )
    if "YCbCr Matrix:" in ass_text:
        ass_text = re.sub(
            r"(?m)^YCbCr Matrix:.*$", "YCbCr Matrix: TV.709", ass_text
        )
    else:
        ass_text = ass_text.replace(
            "ScaledBorderAndShadow: yes\n",
            "ScaledBorderAndShadow: yes\nYCbCr Matrix: TV.709\n",
            1,
        )

    ass_text, replacements = re.subn(
        r"\[V4\+ Styles\]\n.*?(?=\[Events\]\n)",
        STYLE_SECTION,
        ass_text,
        count=1,
        flags=re.DOTALL,
    )
    if replacements != 1:
        raise SystemExit("Could not replace the generated ASS style section")

    dialogue_lines = sum(
        1 for line in ass_text.splitlines() if line.startswith("Dialogue:")
    )
    omitted_cues = 0
    if dialogue_lines != source_cues:
        omitted_cues = validate_omitted_cues(source_text, ass_text)
        if dialogue_lines + omitted_cues != source_cues:
            raise SystemExit(
                f"Cue count changed unexpectedly: SRT={source_cues}, "
                f"ASS={dialogue_lines}, safely omitted={omitted_cues}"
            )

    temporary_output = output.with_suffix(output.suffix + ".tmp")
    temporary_output.write_text(ass_text, encoding="utf-8", newline="\n")
    temporary_output.replace(output)
    omission_note = (
        f", {omitted_cues} empty/duplicate cues omitted" if omitted_cues else ""
    )
    print(
        f"{source.name} -> {output.name} "
        f"({dialogue_lines} visible cues{omission_note})"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
